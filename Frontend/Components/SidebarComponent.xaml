<UserControl x:Class="ProjectBReadyWPF.Frontend.Components.SidebarComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="250">
    
    <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <StackPanel Margin="20,30,20,10">
            <!-- Project Logo/Title -->
            <Image Source="/Frontend/Assets/logo.jpg" Height="60" Margin="0,0,0,30" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Navigation Links -->
            <TextBlock Text="OPERATIONS" Style="{DynamicResource NavSectionLabel}"/>
            <Button x:Name="BtnDashboard" Content="Dashboard" Style="{DynamicResource NavItemActive}"/>
            
            <Button x:Name="BtnShelter" Content="Shelters" Style="{DynamicResource NavItem}" Margin="0,2,0,0"/>
            
            <!-- Admin-only nav items (hidden by default, shown via SetAdminMode) -->
            <Button x:Name="BtnInventory" Content="Inventory" Style="{DynamicResource NavItem}" Visibility="Collapsed"/>
            <Button x:Name="BtnDispatch" Content="Logistics" Style="{DynamicResource NavItem}" Visibility="Collapsed"/>
            <Button x:Name="BtnReport" Content="Reports" Style="{DynamicResource NavItem}" Visibility="Collapsed" Margin="0,2,0,0"/>
        </StackPanel>
    </Border>
</UserControl>