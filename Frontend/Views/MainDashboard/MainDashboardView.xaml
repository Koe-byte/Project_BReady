<UserControl x:Class="ProjectBReadyWPF.Frontend.Views.MainDashboard.MainDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800"
             Background="{StaticResource MainBg}">
<Grid >
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- TOPBAR (.topbar) -->
      <Grid Grid.Row="0" Margin="32,20" Background="{StaticResource MainBg}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="B - READY" Style="{StaticResource PageH1}"/>
          <TextBlock Text="Status and Action" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
          <Button Content="This Month  ˅" Style="{StaticResource BtnPrimary}" Click="OnRefresh" Padding="15,8"/>
        </StackPanel>
      </Grid>

      <!-- PAGE BODY (.page-body) -->
      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="32,28">

          <!-- Stat Cards (.stat-grid — 3 col) -->
          <Grid Margin="0,0,0,28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <!-- Card 1: Active Shelters -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,15,0">
              <StackPanel>
                <TextBlock Text="Active Shelters" Style="{StaticResource CardSubtitle}"/>
                <Grid Margin="0,15,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Viewbox Width="36" Height="36" VerticalAlignment="Center">
                    <Path Fill="{StaticResource Accent}" Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                  </Viewbox>
                  <TextBlock Grid.Column="1" Text="{Binding OpenShelters}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>
            <!-- Card 2: Shelter Capacity -->
            <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="10,0,10,0">
              <StackPanel>
                <TextBlock Text="Shelter Capacity" Style="{StaticResource CardSubtitle}"/>
                <Grid Margin="0,15,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Viewbox Width="36" Height="36" VerticalAlignment="Center">
                    <Path Fill="{StaticResource Accent}" Data="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/>
                  </Viewbox>
                  <TextBlock Grid.Column="1" Text="79% full" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>
            <!-- Card 3: Total Evacuees -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="15,0,0,0">
              <StackPanel>
                <TextBlock Text="Total Evacuees" Style="{StaticResource CardSubtitle}"/>
                <Grid Margin="0,15,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Viewbox Width="36" Height="36" VerticalAlignment="Center">
                    <Path Fill="{StaticResource Accent}" Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                  </Viewbox>
                  <TextBlock Grid.Column="1" Text="{Binding TotalEvacuees}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Evacuation Overview -->
          <Border Style="{StaticResource Card}" Margin="0,0,0,20">
            <Grid Margin="24">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
                <TextBlock Text="Evacuation Overview" Style="{StaticResource CardTitle}" FontSize="20" Margin="0,0,0,20"/>
                
                <!-- Mockup of Donut Chart -->
                <Grid Width="200" Height="200">
                  <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="40" Width="180" Height="180"/>
                  <Ellipse Fill="{StaticResource CardBg}" Width="100" Height="100"/>
                </Grid>
              </StackPanel>
              
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid Margin="0,0,0,30">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#3A3A3A" CornerRadius="25" Width="50" Height="50" Margin="0,0,15,0">
                    <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path Fill="{StaticResource TextMuted}" Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                    </Viewbox>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Total Shelters" Style="{StaticResource CardSubtitle}"/>
                    <TextBlock Text="{Binding TotalShelters}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                  </StackPanel>
                </Grid>
                
                <StackPanel>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Fill="{StaticResource Accent}" Width="8" Height="8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Available (32%)" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Fill="#4D661D" Width="8" Height="8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Occupied (68%)" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Shelter Table Card -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <!-- card-header -->
              <Grid Margin="18,18,18,0"  >
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Evacuation Shelters" Style="{StaticResource CardTitle}"/>
                  <TextBlock Text="Live occupancy status" Style="{StaticResource CardSubtitle}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="View All →"
                        Style="{StaticResource BtnGhost}"
                        VerticalAlignment="Center"
                        Click="OnViewAllShelters"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Border}" Margin="0,14,0,0"/>
              <!-- Table header -->
              <Grid  
                    Margin="16,12"
                    Background="{StaticResource TableHeaderBg}">
<Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="SHELTER NAME"  Style="{StaticResource TableHeader}"/>
                <TextBlock Grid.Column="1" Text="OCCUPANCY"   Style="{StaticResource TableHeader}"/>
                <TextBlock Grid.Column="2" Text="CAPACITY"    Style="{StaticResource TableHeader}"/>
                <TextBlock Grid.Column="3" Text="% FULL"      Style="{StaticResource TableHeader}"/>
                <TextBlock Grid.Column="4" Text="STATUS"      Style="{StaticResource TableHeader}"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Border}"/>
              <!-- Rows -->
              <ItemsControl ItemsSource="{Binding Shelters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid   Margin="16,0">
<Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource TableCellBold}"/>
                      <TextBlock Grid.Column="1" Text="{Binding OccupancyDisplay}"
                             Style="{StaticResource TableCell}"/>
                      <TextBlock Grid.Column="2" Text="{Binding MaxCapacity}"
                             Style="{StaticResource TableCellMuted}"/>
                      <TextBlock Grid.Column="3" Text="{Binding PctFull}"
                             Style="{StaticResource TableCell}"
                             Foreground="{Binding PctColor}"/>
                      <Border Grid.Column="4"
                             Background="{Binding StatusBadgeBg}"
                             BorderBrush="Transparent"
                             CornerRadius="20" Padding="10,3"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{Binding StatusTextColor}"/>
                      </Border>
                      <!-- Row separator -->
                      <Border Grid.ColumnSpan="5" Height="1"
                               Background="{StaticResource Border}"
                               VerticalAlignment="Bottom"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>



        </StackPanel>
      </ScrollViewer>
    </Grid>
</UserControl>