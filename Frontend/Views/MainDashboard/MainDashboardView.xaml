<UserControl x:Class="ProjectBReadyWPF.Frontend.Views.MainDashboard.MainDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800"
             Background="{DynamicResource MainBg}">
<Grid>
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Frontend/Assets/ResidentTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </ResourceDictionary>
  </Grid.Resources>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- TOPBAR -->
      <Grid Grid.Row="0" Margin="32,20" Background="{DynamicResource MainBg}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="B - READY" Style="{DynamicResource ResidentPageH1}"/>
          <TextBlock Text="Barangay Disaster Response Dashboard" Style="{DynamicResource ResidentPageSubtitle}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding LastUpdatedDisplay}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Border Style="{DynamicResource LiveStatusBadge}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="#4ADE80" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="LIVE" Style="{DynamicResource LiveStatusLabel}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- PAGE BODY -->
      <ScrollViewer Grid.Row="1" Style="{DynamicResource SlimScrollViewer}">
        <StackPanel Margin="32,10,32,32">

          <!-- Connection error -->
          <Border Style="{DynamicResource AlertDanger}" Margin="0,0,0,16"
                  Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Top">
                <Path Fill="#DC2626" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
              </Viewbox>
              <TextBlock Text="{Binding LoadErrorMessage}" TextWrapping="Wrap" FontSize="13"
                         Foreground="{DynamicResource AlertCriticalText}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- Compact status strip (single container, high contrast) -->
          <Border Margin="0,0,0,16" CornerRadius="10" Padding="12,10" BorderThickness="1"
                  Background="#0A1A12" BorderBrush="#22C55E">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasLoadError}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding HasUrgentAlerts}" Value="True">
                    <Setter Property="BorderBrush" Value="#CA8A04"/>
                    <Setter Property="Background" Value="#1C1608"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <ItemsControl ItemsSource="{Binding Alerts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Ellipse Width="8" Height="8" Fill="{Binding IconColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Message}" FontSize="13" Foreground="#F0FDF4" TextWrapping="Wrap"
                               VerticalAlignment="Center" LineHeight="18"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <!-- STAT CARDS (3-col) -->
          <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource StatCard}" Margin="0,0,12,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource AccentLight}" CornerRadius="14" Width="52" Height="52" VerticalAlignment="Center">
                  <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Fill="{DynamicResource Accent}" Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                  </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                  <TextBlock Text="Active Shelters" Style="{DynamicResource CardSubtitle}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding OpenShelters}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding ShelterCountNote}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource StatCard}" Margin="6,0,6,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource GreenLight}" CornerRadius="14" Width="52" Height="52" VerticalAlignment="Center">
                  <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Fill="{DynamicResource Green}" Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                  </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                  <TextBlock Text="Total Evacuees" Style="{DynamicResource CardSubtitle}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding TotalEvacuees}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="individuals" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource StatCard}" Margin="12,0,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource AccentLight}" CornerRadius="14" Width="52" Height="52" VerticalAlignment="Center">
                  <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Fill="{DynamicResource Accent}" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                  </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                  <TextBlock Text="Available Capacity" Style="{DynamicResource CardSubtitle}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding AvailableSlots}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding CapacityNote}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!-- Donut Chart + Shelter Bar Chart -->
          <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,12,0" Padding="20">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Evacuation Overview" Style="{DynamicResource CardTitle}" FontSize="16" Margin="0,0,0,14"/>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Grid Grid.Column="0" Width="132" Height="132" Margin="0,0,16,0">
                    <Ellipse Stroke="{DynamicResource ChartTrack}" StrokeThickness="22" Width="132" Height="132"/>
                    <Ellipse x:Name="AvailableArc" Stroke="{DynamicResource ChartAvailable}" StrokeThickness="22"
                             Width="132" Height="132" RenderTransformOrigin="0.5,0.5"
                             StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                      <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90"/>
                      </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="OccupiedArc" Stroke="{DynamicResource ChartOccupied}" StrokeThickness="22"
                             Width="132" Height="132" RenderTransformOrigin="0.5,0.5"
                             StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                      <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90"/>
                      </Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock x:Name="DonutPctLabel" Text="0%" FontSize="24" FontWeight="Bold"
                                 Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                      <TextBlock Text="occupied" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OccupancyHeadline}" FontSize="15" FontWeight="Bold"
                               Foreground="{Binding OccupancyHeadlineColor}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding OccupancySummary}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,0,10"/>
                    <Grid x:Name="OccupancyBarTrack" Height="10" Margin="0,0,0,10">
                      <Border Background="{DynamicResource ChartTrack}" CornerRadius="6"/>
                      <Border Background="{DynamicResource ChartOccupied}" CornerRadius="6" HorizontalAlignment="Left"
                              RenderTransformOrigin="0,0.5"
                              Width="{Binding ActualWidth, ElementName=OccupancyBarTrack}">
                        <Border.RenderTransform>
                          <ScaleTransform ScaleX="{Binding OccupancyFillPercent}"/>
                        </Border.RenderTransform>
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding ShelterStatusLine}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                  </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="2" Columns="3">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Occupied" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="LegendOccupied" Text="0" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource ChartOccupied}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Margin="4,0">
                    <TextBlock Text="Available" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="LegendAvailable" Text="0" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource ChartAvailable}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="Total capacity" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="LegendTotal" Text="0" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                  </StackPanel>
                </UniformGrid>
              </Grid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="12,0,0,0" Padding="24">
              <StackPanel>
                <Grid Margin="0,0,0,20">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Shelter Occupancy" Style="{DynamicResource CardTitle}" FontSize="16"/>
                    <TextBlock Text="Real-time capacity per shelter" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource AccentLight}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock x:Name="FullSheltersBadge" Text="0 shelters full" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold"/>
                  </Border>
                </Grid>
                <ItemsControl x:Name="BarChartItems" ItemsSource="{Binding Shelters}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,16">
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{Binding OccupancyDisplay}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                        </Grid>
                        <Border Background="{DynamicResource BorderStrong}" CornerRadius="7" Height="14" ClipToBounds="True">
                          <Border Background="{Binding FillColor}" CornerRadius="0" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                              <ScaleTransform ScaleX="{Binding FillPercent}"/>
                            </Border.RenderTransform>
                          </Border>
                        </Border>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding PctFull}" Foreground="{Binding PctColor}" FontSize="11"/>
                          <Border Grid.Column="1" Background="{Binding StatusBadgeBg}" CornerRadius="10" Padding="8,2">
                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusTextColor}"/>
                          </Border>
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Recent relief activity -->
          <Border Style="{DynamicResource Card}" Padding="24" Margin="0,0,0,24">
            <StackPanel>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Recent Relief Activity" Style="{DynamicResource CardTitle}" FontSize="16"/>
                  <TextBlock Text="Latest goods dispatched to shelters" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentLight}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DispatchCount, StringFormat={}{0} total}" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold"/>
                </Border>
              </Grid>

              <ItemsControl ItemsSource="{Binding RecentDispatches}">
                <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasRecentDispatches}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="0,0,0,0" Margin="0,0,0,10" Background="Transparent">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource GreenLight}" CornerRadius="10" Width="40" Height="40" Margin="0,0,14,0">
                          <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Fill="{DynamicResource Green}" Data="M18 18.5a1.5 1.5 0 0 1-1.5 1.5H5.5A1.5 1.5 0 0 1 4 18.5V6.5A1.5 1.5 0 0 1 5.5 5h3.75L11 3h2l1.75 2H18.5A1.5 1.5 0 0 1 20 6.5v12z"/>
                          </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding TitleLine}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                          <TextBlock Text="{Binding DetailLine}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding DateTimeDisplay}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Padding="28,24" CornerRadius="12" Background="{DynamicResource TableHeaderBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasRecentDispatches}" Value="False">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="No dispatches yet" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                  <TextBlock Text="Relief deliveries will appear here as they are logged." FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Summary strip -->
          <Border Style="{DynamicResource Card}" Padding="24">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ReliefItems}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                <TextBlock Text="Relief Items" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ItemTypes}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                <TextBlock Text="Item Categories" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <TextBlock Text="{Binding DispatchCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                <TextBlock Text="Dispatches" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                <TextBlock Text="{Binding FullShelterCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Red}" HorizontalAlignment="Center"/>
                <TextBlock Text="Shelters Full" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>
</UserControl>
