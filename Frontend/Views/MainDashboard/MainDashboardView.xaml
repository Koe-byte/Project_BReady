<UserControl x:Class="ProjectBReadyWPF.Frontend.Views.MainDashboard.MainDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800"
             Background="{DynamicResource MainBg}">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- TOPBAR -->
      <Grid Grid.Row="0" Margin="32,20" Background="{DynamicResource MainBg}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="B - READY" Style="{DynamicResource PageH1}"/>
          <TextBlock Text="Barangay Disaster Response Dashboard" Style="{DynamicResource PageSubtitle}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
          <Border Background="{DynamicResource TealLight}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
            <TextBlock Text="● Live" Foreground="{DynamicResource Teal}" FontSize="11" FontWeight="Bold"/>
          </Border>
        </StackPanel>
      </Grid>

      <!-- PAGE BODY -->
      <ScrollViewer Grid.Row="1" Style="{DynamicResource SlimScrollViewer}">
        <StackPanel Margin="32,10,32,32">

          <!-- STAT CARDS (3-col) -->
          <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource StatCard}" Margin="0,0,12,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource AccentLight}" CornerRadius="14" Width="52" Height="52" VerticalAlignment="Center">
                  <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Fill="{DynamicResource Accent}" Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                  </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                  <TextBlock Text="Active Shelters" Style="{DynamicResource CardSubtitle}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding OpenShelters}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding ShelterCountNote}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource StatCard}" Margin="6,0,6,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource BlueLight}" CornerRadius="14" Width="52" Height="52" VerticalAlignment="Center">
                  <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Fill="{DynamicResource Blue}" Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                  </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                  <TextBlock Text="Total Evacuees" Style="{DynamicResource CardSubtitle}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding TotalEvacuees}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="individuals" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource StatCard}" Margin="12,0,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource TealLight}" CornerRadius="14" Width="52" Height="52" VerticalAlignment="Center">
                  <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Fill="{DynamicResource Teal}" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                  </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                  <TextBlock Text="Available Capacity" Style="{DynamicResource CardSubtitle}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding AvailableSlots}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Teal}"/>
                    <TextBlock Text="{Binding CapacityNote}" FontSize="13" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!-- Donut Chart + Shelter Bar Chart -->
          <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,12,0" Padding="24">
              <StackPanel>
                <TextBlock Text="Evacuation Overview" Style="{DynamicResource CardTitle}" FontSize="16" Margin="0,0,0,20"/>
                <Grid Width="180" Height="180" HorizontalAlignment="Center" Margin="0,0,0,20">
                  <Ellipse Stroke="#22C55E" StrokeThickness="28" Width="160" Height="160"/>
                  <Ellipse x:Name="OccupiedArc" Stroke="#EF4444" StrokeThickness="28" Width="160" Height="160"
                           RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                      <RotateTransform Angle="-90"/>
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="DonutPctLabel" Text="0%" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Occupied" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <StackPanel Margin="0,4,0,0">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Fill="#EF4444" Width="10" Height="10" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Occupied" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LegendOccupied" Grid.Column="2" Text="0" FontWeight="Bold" Foreground="#EF4444" FontSize="13" VerticalAlignment="Center"/>
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Fill="#22C55E" Width="10" Height="10" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Available" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LegendAvailable" Grid.Column="2" Text="0" FontWeight="Bold" Foreground="#22C55E" FontSize="13" VerticalAlignment="Center"/>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource Border}" Margin="0,4,0,8"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Total Capacity" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                    <TextBlock x:Name="LegendTotal" Grid.Column="1" Text="0" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="12,0,0,0" Padding="24">
              <StackPanel>
                <Grid Margin="0,0,0,20">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Shelter Occupancy" Style="{DynamicResource CardTitle}" FontSize="16"/>
                    <TextBlock Text="Real-time capacity per shelter" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource AccentLight}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock x:Name="FullSheltersBadge" Text="0 shelters full" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold"/>
                  </Border>
                </Grid>
                <ItemsControl x:Name="BarChartItems" ItemsSource="{Binding Shelters}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,16">
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{Binding OccupancyDisplay}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                        </Grid>
                        <Border Background="{DynamicResource BorderStrong}" CornerRadius="7" Height="14" ClipToBounds="True">
                          <Border Background="{Binding FillColor}" CornerRadius="0" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                              <ScaleTransform ScaleX="{Binding FillPercent}"/>
                            </Border.RenderTransform>
                          </Border>
                        </Border>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding PctFull}" Foreground="{Binding PctColor}" FontSize="11"/>
                          <Border Grid.Column="1" Background="{Binding StatusBadgeBg}" CornerRadius="10" Padding="8,2">
                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusTextColor}"/>
                          </Border>
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Summary strip -->
          <Border Style="{DynamicResource Card}" Padding="24">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ReliefItems}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                <TextBlock Text="Relief Items" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="{Binding ItemTypes}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                <TextBlock Text="Item Categories" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <TextBlock Text="{Binding DispatchCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                <TextBlock Text="Dispatches" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                <TextBlock Text="{Binding FullShelterCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Amber}" HorizontalAlignment="Center"/>
                <TextBlock Text="Shelters Full" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>
</UserControl>
