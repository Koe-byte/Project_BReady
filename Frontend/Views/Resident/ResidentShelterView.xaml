<UserControl x:Class="ProjectBReadyWPF.Frontend.Views.Resident.ResidentShelterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800"
             Background="{StaticResource MainBg}">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- TOPBAR -->
      <Grid Grid.Row="0" Margin="32,20" Background="{StaticResource MainBg}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Evacuation Shelters" Style="{StaticResource PageH1}"/>
          <TextBlock Text="Real-time shelter availability and occupancy status" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
      </Grid>

      <!-- PAGE BODY -->
      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="32,10">

          <!-- Summary Stat Cards (3-col) -->
          <Grid Margin="0,0,0,28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <!-- Card 1: Total Shelters -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,15,0">
              <StackPanel>
                <TextBlock Text="Total Shelters" Style="{StaticResource CardSubtitle}"/>
                <Grid Margin="0,15,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Viewbox Width="36" Height="36" VerticalAlignment="Center">
                    <Path Fill="{StaticResource Accent}" Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                  </Viewbox>
                  <TextBlock Grid.Column="1" Text="{Binding TotalShelters}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>
            <!-- Card 2: Available Slots -->
            <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="10,0,10,0">
              <StackPanel>
                <TextBlock Text="Available Slots" Style="{StaticResource CardSubtitle}"/>
                <Grid Margin="0,15,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Viewbox Width="36" Height="36" VerticalAlignment="Center">
                    <Path Fill="{StaticResource Accent}" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                  </Viewbox>
                  <TextBlock Grid.Column="1" Text="{Binding AvailableSlots}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>
            <!-- Card 3: Total Evacuees -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="15,0,0,0">
              <StackPanel>
                <TextBlock Text="Total Evacuees" Style="{StaticResource CardSubtitle}"/>
                <Grid Margin="0,15,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Viewbox Width="36" Height="36" VerticalAlignment="Center">
                    <Path Fill="{StaticResource Accent}" Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                  </Viewbox>
                  <TextBlock Grid.Column="1" Text="{Binding TotalEvacuees}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Shelter Cards Grid (graphical per-shelter status) -->
          <TextBlock Text="Shelter Status" Style="{StaticResource CardTitle}" Margin="0,0,0,16"/>
          <ItemsControl ItemsSource="{Binding Shelters}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Width="340" Margin="0,0,16,16" Padding="20">
                  <StackPanel>
                    <!-- Shelter Name -->
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                    
                    <!-- Occupancy Progress Bar -->
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="Occupancy" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                      <TextBlock Grid.Column="1" Text="{Binding OccupancyDisplay}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    </Grid>
                    <!-- Progress bar background -->
                    <Border Background="#404040" CornerRadius="4" Height="10" Margin="0,0,0,12">
                      <Border Background="{Binding FillColor}" CornerRadius="4" Height="10"
                              HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                    </Border>
                    
                    <!-- Status Row -->
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Ellipse Width="10" Height="10" Fill="{Binding FillColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding PctFull}" Foreground="{Binding PctColor}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                      </StackPanel>
                      <Border Grid.Column="1"
                              Background="{Binding StatusBadgeBg}"
                              BorderBrush="Transparent"
                              CornerRadius="12" Padding="12,4"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}"
                                FontSize="11" FontWeight="Bold"
                                Foreground="{Binding StatusTextColor}"/>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>
    </Grid>
</UserControl>
