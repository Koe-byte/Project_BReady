<Window x:Class="ProjectBReadyWPF.Frontend.Views.Resident.ResidentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dashboard="clr-namespace:ProjectBReadyWPF.Frontend.Views.MainDashboard"
        Title="Project B-Ready — Evacuation Monitoring" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MainBg}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Frontend/Assets/ResidentTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Full-width kiosk: no sidebar, just the dashboard -->
    <dashboard:MainDashboardView x:Name="DashboardView"/>
</Window>
