<Window x:Class="ProjectBReadyWPF.Frontend.Views.Resident.ResidentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dashboard="clr-namespace:ProjectBReadyWPF.Frontend.Views.MainDashboard"
        Title="Project B-Ready — Evacuation Monitoring" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MainBg}"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <!-- Full-width kiosk: no sidebar, just the dashboard -->
    <dashboard:MainDashboardView x:Name="DashboardView"/>
</Window>