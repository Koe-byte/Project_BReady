<UserControl x:Class="ProjectBReadyWPF.Frontend.Views.Shelter.ShelterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="800"
             Background="{DynamicResource MainBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOPBAR -->
        <Grid Grid.Row="0" Margin="32,20" Background="{DynamicResource MainBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Shelter Management" Style="{DynamicResource PageH1}"/>
                <TextBlock Text="Manage evacuation centers and occupancy records" Style="{DynamicResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource TealLight}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="● Live" Foreground="{DynamicResource Teal}" FontSize="11" FontWeight="Bold"/>
                </Border>
                <Button Content="+ Add Shelter" Style="{DynamicResource BtnPrimary}" Click="OnAddShelter"/>
            </StackPanel>
        </Grid>

        <!-- PAGE BODY -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28">

                <!-- Stat Cards (3-col) -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Shelters -->
                    <Border Grid.Column="0" Style="{DynamicResource StatCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <Border Background="{DynamicResource TealLight}"
                                    CornerRadius="12" Width="44" Height="44"
                                    Padding="0" BorderBrush="Transparent"
                                    HorizontalAlignment="Left" Margin="0,0,0,14">
                                <TextBlock Text="🏛️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding TotalShelters}" Style="{DynamicResource StatValue}"/>
                            <TextBlock Text="Total Shelters" Style="{DynamicResource StatLabel}"/>
                            <TextBlock Text="All registered centers" Style="{DynamicResource StatSub}"/>
                            <Border Height="3" CornerRadius="2" Margin="0,12,0,0" Background="{DynamicResource Teal}"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Occupancy -->
                    <Border Grid.Column="1" Style="{DynamicResource StatCard}" Margin="4,0">
                        <StackPanel>
                            <Border Background="{DynamicResource AccentLight}"
                                    CornerRadius="12" Width="44" Height="44"
                                    Padding="0" BorderBrush="Transparent"
                                    HorizontalAlignment="Left" Margin="0,0,0,14">
                                <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding TotalOccupancy}" Style="{DynamicResource StatValue}"/>
                            <TextBlock Text="Total Occupancy" Style="{DynamicResource StatLabel}"/>
                            <TextBlock Text="{Binding CombinedCapacityNote}" Style="{DynamicResource StatSub}"/>
                            <Border Height="3" CornerRadius="2" Margin="0,12,0,0" Background="{DynamicResource Accent}"/>
                        </StackPanel>
                    </Border>

                    <!-- Shelters at Full -->
                    <Border Grid.Column="2" Style="{DynamicResource StatCard}" Margin="8,0,0,0">
                        <StackPanel>
                            <Border Background="{DynamicResource RedLight}"
                                    CornerRadius="12" Width="44" Height="44"
                                    Padding="0" BorderBrush="Transparent"
                                    HorizontalAlignment="Left" Margin="0,0,0,14">
                                <TextBlock Text="🚫" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding FullShelterCount}" Style="{DynamicResource StatValue}"/>
                            <TextBlock Text="Shelters at Full" Style="{DynamicResource StatLabel}"/>
                            <TextBlock Text="Require overflow action" Style="{DynamicResource StatSub}"/>
                            <Border Height="3" CornerRadius="2" Margin="0,12,0,0" Background="{DynamicResource Red}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Table Card -->
                <Border Style="{DynamicResource Card}">
                    <StackPanel>

                        <!-- Toolbar -->
                        <Grid Margin="14,14" Background="{DynamicResource CardBg}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="5" Height="1" Background="{DynamicResource Border}" VerticalAlignment="Bottom"/>

                            <!-- Search -->
                            <Border Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="8" Padding="8,4" Background="White" MinWidth="210">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                             FontSize="13" Width="170" VerticalAlignment="Center"
                                             TextChanged="OnSearchChanged"/>
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="1" Content="✏️ Edit Shelter" Style="{DynamicResource BtnGhost}"
                                    Click="OnEditShelter" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Content="🗑 Delete" Style="{DynamicResource BtnGhost}"
                                    Click="OnDeleteSelected" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Table Header -->
                        <Grid Margin="16,8,16,0" Background="{DynamicResource TableHeaderBg}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="2*" MinWidth="150"/>
                                <ColumnDefinition Width="*" MinWidth="80"/>
                                <ColumnDefinition Width="*" MinWidth="80"/>
                                <ColumnDefinition Width="*" MinWidth="80"/>
                                <ColumnDefinition Width="2*" MinWidth="150"/>
                                <ColumnDefinition Width="1.5*" MinWidth="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="#" Style="{DynamicResource TableHeader}"/>
                            <TextBlock Grid.Column="2" Text="SHELTER NAME" Style="{DynamicResource TableHeader}"/>
                            <TextBlock Grid.Column="3" Text="MAX CAP." Style="{DynamicResource TableHeader}"/>
                            <TextBlock Grid.Column="4" Text="CURRENT" Style="{DynamicResource TableHeader}"/>
                            <TextBlock Grid.Column="5" Text="AVAILABLE" Style="{DynamicResource TableHeader}"/>
                            <TextBlock Grid.Column="6" Text="OCCUPANCY" Style="{DynamicResource TableHeader}"/>
                            <TextBlock Grid.Column="7" Text="STATUS" Style="{DynamicResource TableHeader}"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Border}"/>

                        <!-- Rows -->
                        <ItemsControl x:Name="ShelterTable" ItemsSource="{Binding Shelters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,8,16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="2*" MinWidth="150"/>
                                            <ColumnDefinition Width="*" MinWidth="80"/>
                                            <ColumnDefinition Width="*" MinWidth="80"/>
                                            <ColumnDefinition Width="*" MinWidth="80"/>
                                            <ColumnDefinition Width="2*" MinWidth="150"/>
                                            <ColumnDefinition Width="1.5*" MinWidth="140"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0" GroupName="ShelterSelect" VerticalAlignment="Center"
                                                     Checked="OnShelterRadioChecked" Tag="{Binding ShelterID}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RowNumber}" Style="{DynamicResource TableCellMuted}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{DynamicResource TableCellBold}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding MaxCapacity}" Style="{DynamicResource TableCell}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding CurrentOccupancy}" Style="{DynamicResource TableCell}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Available}" Style="{DynamicResource TableCell}"
                                                   Foreground="{Binding AvailableColor}"/>
                                        <!-- Progress bar -->
                                        <Grid Grid.Column="6" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Height="6" Margin="0,0,8,0">
                                                <Border Background="{DynamicResource Border}" CornerRadius="3" Height="6"/>
                                                <Border Background="{Binding FillColor}" CornerRadius="3" Height="6"
                                                        HorizontalAlignment="Stretch"
                                                        RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding FillPercent}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding PctFull}" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <!-- Status badge -->
                                        <Border Grid.Column="7" Background="{Binding StatusBadgeBg}"
                                                CornerRadius="20" Padding="10,3" BorderBrush="Transparent"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding StatusTextColor}"/>
                                        </Border>
                                        <!-- Row separator -->
                                        <Border Grid.ColumnSpan="8" Height="1" Background="{DynamicResource Border}"
                                                VerticalAlignment="Bottom"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- MODAL: Edit Shelter -->
        <Grid x:Name="ModalEditOverlay" Grid.RowSpan="2" Visibility="Collapsed"
              Background="#73000000">
            <Border CornerRadius="16" Background="White" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="460" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="26,22,26,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Edit Shelter" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="EditShelterSubtitle" FontSize="13"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Background="Transparent"
                                Foreground="{DynamicResource TextMuted}" FontSize="18"
                                Width="32" Height="32" Click="OnCloseEditModal"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}"/>
                    <StackPanel Margin="26,20">
                        <!-- Shelter Name -->
                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6">
                            <Run Text="Shelter Name "/>
                            <Run Text="*" Foreground="{DynamicResource Red}"/>
                        </TextBlock>
                        <TextBox x:Name="EditNameInput" FontSize="14" Padding="10,8"
                                 BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,0,0,16"/>

                        <!-- Status -->
                        <TextBlock Text="Status" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="EditStatusPicker" FontSize="14" Padding="10,8"
                                  BorderBrush="{DynamicResource Border}" Margin="0,0,0,16">
                            <ComboBoxItem Content="Open"/>
                            <ComboBoxItem Content="Full"/>
                            <ComboBoxItem Content="Closed"/>
                            <ComboBoxItem Content="Under Maintenance"/>
                        </ComboBox>

                        <!-- Current Occupancy -->
                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6">
                            <Run Text="Current Occupancy "/>
                            <Run x:Name="EditMaxCapLabel" Text="" Foreground="{DynamicResource TextMuted}"/>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="−" FontSize="18" FontWeight="Bold"
                                    Width="40" Height="38" Background="#F1F5F9" Foreground="#334155"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1,1,0,1"
                                    Click="OnOccDecrement" Cursor="Hand"/>
                            <TextBox x:Name="EditOccInput" Grid.Column="1" FontSize="14" Padding="10,8"
                                     BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                     HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="2" Content="+" FontSize="18" FontWeight="Bold"
                                    Width="40" Height="38" Background="#F1F5F9" Foreground="#334155"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,1,1"
                                    Click="OnOccIncrement" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource Border}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,16">
                        <Button Content="Cancel" Style="{DynamicResource BtnGhost}" Click="OnCloseEditModal"/>
                        <Button Content="💾 Save Changes" Style="{DynamicResource BtnPrimary}"
                                Margin="10,0,0,0" Click="OnSaveEdit"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL: Delete Shelter -->
        <Grid x:Name="ModalDeleteOverlay" Grid.RowSpan="2" Visibility="Collapsed"
              Background="#73000000">
            <Border CornerRadius="16" Background="White" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="420" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="26,22,26,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Delete Shelter" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="This action cannot be undone" FontSize="13"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Background="Transparent"
                                Foreground="{DynamicResource TextMuted}" FontSize="18"
                                Width="32" Height="32" Click="OnCloseDeleteModal"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Border}"/>
                    <StackPanel Margin="26,24">
                        <Border Style="{DynamicResource AlertWarn}" Padding="14">
                            <TextBlock x:Name="DeleteShelterLabel" FontSize="13" Foreground="#991B1B" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource Border}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,16">
                        <Button Content="Cancel" Style="{DynamicResource BtnGhost}" Click="OnCloseDeleteModal"/>
                        <Button Content="🗑 Yes, Delete" Background="#DC2626" Foreground="White"
                                Padding="16,8" Margin="10,0,0,0" Click="OnConfirmDelete"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
